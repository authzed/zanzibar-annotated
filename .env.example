# Copy to .env.local for local development. All variables are optional.

# Public base URL of the site, used in share preview (Open Graph) image URLs.
# Defaults to https://$VERCEL_URL on Vercel, and otherwise to
# http://localhost:$PORT.
# PREVIEW_ENDPOINT=https://example.com

# PostHog analytics. Disabled unless NEXT_PUBLIC_POSTHOG_KEY is set.
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_api_key
# API host, or the path of a reverse proxy on the same host (for example
# /ingest). Defaults to PostHog US Cloud.
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# PostHog app URL, used for toolbar links when events go through a proxy.
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
